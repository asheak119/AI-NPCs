{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Engine Function Call",
  "type": "object",
  "properties": {
    "function_name": {
      "type": "string",
      "enum": ["set_disposition", "trigger_hostility", "grant_objective"],
      "description": "The name of the engine function to invoke."
    },
    "arguments": {
      "type": "object",
      "description": "Key-value map of arguments required for the function.",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    }
  },
  "required": ["function_name"]
}
